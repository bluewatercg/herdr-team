{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:herdr:schema:ledger-event:1.3",
  "oneOf":[{"$ref":"#/$defs/evidenceEvent"},{"$ref":"#/$defs/acceptanceEvent"}],
  "$defs":{
    "baseProperties":{
      "schema_version":{"const":"herdr-ledger-event/1.3"},
      "event_id":{"type":"string","minLength":1},
      "event_type":{"enum":["EVIDENCE_OBSERVED","ACCEPTANCE_RECORDED"]},
      "task_id":{"type":"string","minLength":1},
      "subject_revision":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
      "idempotency_key":{"type":"string","minLength":1},
      "occurred_at":{"type":"string","format":"date-time"},
      "received_at":{"type":"string","format":"date-time"},
      "payload_canonicalization":{"const":"JCS"},
      "payload_digest_algorithm":{"const":"sha256"},
      "payload_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
    },
    "evidencePayload":{"type":"object","additionalProperties":false,"required":["evidence_id","classification","reason_codes","source_ref"],"properties":{"evidence_id":{"type":["string","null"],"minLength":1},"classification":{"enum":["DISPATCHABLE","NOT_READY","NOT_SUBMISSION","MALFORMED","UNKNOWN_STATUS","CONFLICTED"]},"reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"source_ref":{"type":"string","minLength":1}}},
    "acceptancePayload":{"type":"object","additionalProperties":false,"required":["criterion_id","generation","supersedes_event_id","result","evidence_refs","reason_code","reason"],"properties":{"criterion_id":{"type":"string","minLength":1},"generation":{"type":"integer","minimum":1},"supersedes_event_id":{"type":["string","null"]},"result":{"enum":["PASS","FAIL","UNVERIFIED"]},"evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"reason_code":{"type":["string","null"]},"reason":{"type":["string","null"]}}},
    "evidenceEvent":{"type":"object","additionalProperties":false,"required":["schema_version","event_id","event_type","task_id","subject_revision","idempotency_key","occurred_at","received_at","payload_canonicalization","payload_digest_algorithm","payload_digest","payload"],"properties":{"schema_version":{"const":"herdr-ledger-event/1.3"},"event_id":{"type":"string","minLength":1},"event_type":{"const":"EVIDENCE_OBSERVED"},"task_id":{"type":"string","minLength":1},"subject_revision":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"idempotency_key":{"type":"string","minLength":1},"occurred_at":{"type":"string","format":"date-time"},"received_at":{"type":"string","format":"date-time"},"payload_canonicalization":{"const":"JCS"},"payload_digest_algorithm":{"const":"sha256"},"payload_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"payload":{"$ref":"#/$defs/evidencePayload"}}},
    "acceptanceEvent":{"type":"object","additionalProperties":false,"required":["schema_version","event_id","event_type","task_id","subject_revision","idempotency_key","occurred_at","received_at","payload_canonicalization","payload_digest_algorithm","payload_digest","payload"],"properties":{"schema_version":{"const":"herdr-ledger-event/1.3"},"event_id":{"type":"string","minLength":1},"event_type":{"const":"ACCEPTANCE_RECORDED"},"task_id":{"type":"string","minLength":1},"subject_revision":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"idempotency_key":{"type":"string","minLength":1},"occurred_at":{"type":"string","format":"date-time"},"received_at":{"type":"string","format":"date-time"},"payload_canonicalization":{"const":"JCS"},"payload_digest_algorithm":{"const":"sha256"},"payload_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"payload":{"$ref":"#/$defs/acceptancePayload"}}}
  }
}
