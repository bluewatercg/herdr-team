{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:herdr:schema:dashboard-projection:1.3",
  "type":"object","additionalProperties":false,
  "required":["schema_version","task_id","subject_revision","ingestion_status","evidence_status","acceptance_status","criteria","diagnostics","generated_from_event_digest","reducer_version"],
  "properties":{
    "schema_version":{"const":"herdr-dashboard-projection/1.3"},
    "task_id":{"type":"string","minLength":1},
    "subject_revision":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "ingestion_status":{"enum":["VALID","CONFLICTED","INVALID_PAYLOAD"]},
    "evidence_status":{"enum":["DISPATCHABLE","NOT_READY","NOT_SUBMISSION","MALFORMED","UNKNOWN_STATUS","CONFLICTED","UNAVAILABLE"]},
    "acceptance_status":{"enum":["PASS","FAIL","UNVERIFIED","PENDING","INVALID","STALE","CONFLICTED","UNAVAILABLE"]},
    "criteria":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["criterion_id","required","status","generation","selected_event_id","superseded_event_ids","evidence_refs","reason_codes"],"properties":{"criterion_id":{"type":"string","minLength":1},"required":{"type":"boolean"},"status":{"enum":["PASS","FAIL","UNVERIFIED","PENDING","INVALID","STALE","CONFLICTED"]},"generation":{"type":["integer","null"],"minimum":1},"selected_event_id":{"type":["string","null"]},"superseded_event_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}}},
    "diagnostics":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["source_ref","code"],"properties":{"source_ref":{"type":"string","minLength":1},"code":{"type":"string","minLength":1}}}},
    "generated_from_event_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "reducer_version":{"type":"string","minLength":1}
  }
}
