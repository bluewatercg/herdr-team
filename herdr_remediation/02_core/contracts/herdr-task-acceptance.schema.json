{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-task-acceptance/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "subject_revision", "acceptance_results", "repair", "regression"],
  "properties": {
    "schema_version": {"const": "herdr-task-acceptance/1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "subject_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {"type": {"enum": ["git", "artifact-set"]}, "value": {"type": "string", "minLength": 1}}
    },
    "acceptance_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "result", "evidence_refs", "reason_code", "reason"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reason_code": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        },
        "allOf": [
          {"if": {"properties": {"result": {"const": "PASS"}}}, "then": {"properties": {"evidence_refs": {"minItems": 1}, "reason_code": {"type": "null"}}}},
          {"if": {"properties": {"result": {"const": "FAIL"}}}, "then": {"properties": {"evidence_refs": {"minItems": 1}, "reason_code": {"type": "string", "minLength": 1}}}},
          {"if": {"properties": {"result": {"const": "UNVERIFIED"}}}, "then": {"properties": {"reason_code": {"type": "string", "minLength": 1}}}}
        ]
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false,
      "required": ["current_round", "max_rounds", "status", "finding_refs"],
      "properties": {
        "current_round": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_rounds": {"const": 2},
        "status": {"enum": ["NOT_REQUIRED", "PENDING", "IN_PROGRESS", "READY_FOR_REVIEW", "PASSED", "EXHAUSTED"]},
        "finding_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "regression": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "scope", "result", "evidence_refs", "reason_code", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "scope": {"enum": ["FULL", null]},
        "result": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_code": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
