{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-delivery-profile/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_revision", "status", "delivery_mode", "primary_goal", "must_prove", "approved_constraints", "blocking_risk_flags", "deferred_scope", "agent_calibration"],
  "properties": {
    "schema_version": {"const": "herdr-delivery-profile/1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
    "delivery_mode": {"enum": ["MVP1_PROOF", "MVP2_REPEATABLE", "PRODUCTIZATION", "REGULATED_RELEASE"]},
    "primary_goal": {"type": "string", "minLength": 1},
    "must_prove": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "approved_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocking_risk_flags": {"type": "array", "items": {"enum": ["SCIENTIFIC_RESULT", "DATA_INTEGRITY", "EVIDENCE_TRUST", "REVISION_IDENTITY", "SECURITY_PRIVACY", "IRREVERSIBLE_MIGRATION", "EXTERNAL_COMPATIBILITY", "REGULATORY_CLAIM"]}, "uniqueItems": true},
    "deferred_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "agent_calibration": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1}
  }
}
